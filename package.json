{
  "name": "quest",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "db:init": "node scripts/init_database.js",
    "stack:start": "npm ci --omit=dev && npm run db:init && docker compose up --build -d",
    "stack:stop": "docker compose stop",
    "test:postgres": "node --test tests/postgres.integration.js",
    "db:backup": "node scripts/backup_database.js",
    "db:migrate": "node scripts/migrate_sqlite.js",
    "db:restore": "node scripts/restore_database.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
